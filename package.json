{
  "name": "peachyland",
  "version": "1.0.0",
  "description": "Ruleta de acciones y cartas de Peachyland",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.peachyland.desktop",
    "productName": "Peachyland",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "files": [
      "index.html",
      "src/**/*",
      "electron/**/*",
      "background.png",
      "perfil.png",
      "package.json"
    ],
    "win": {
      "icon": "perfil.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Peachyland-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Peachyland-Portable-${version}-${arch}.${ext}"
    }
  }
}
